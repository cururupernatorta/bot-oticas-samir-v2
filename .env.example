# ── Banco ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/botsaas?retryWrites=true&w=majority

# ── IA ───────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-sua_chave_aqui
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=400

# Prompt caching. O system prompt é idêntico em toda mensagem de um mesmo
# cliente, então cacheá-lo corta ~66% do custo de IA. TTL '1h' é o padrão e o
# mais barato para o nosso perfil de tráfego — ver docs/CUSTOS.md.
CACHE_TTL=1h

# LOG_CACHE=1 imprime leitura/escrita de cache a cada mensagem.
# Se "leu" vier sempre 0, algo voltou a entrar no prefixo. Rode npm test.
LOG_CACHE=0

# Câmbio EFETIVO: cotação do dólar + IOF (3,5%) + spread do cartão. Revise todo mês.
CAMBIO_USD_BRL=5.40

# ── Banco ────────────────────────────────────────────────────────────────────
MONGO_POOL=50

# ── Painel ───────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=troque_por_uma_senha_forte
PORT=3000

# ── Relatórios ───────────────────────────────────────────────────────────────
# Dia da semana (0=domingo) e hora do envio do relatório semanal
RELATORIO_DIA=0
RELATORIO_HORA=9

# Instância Z-API e número que RECEBEM o relatório consolidado de todos os clientes
OWNER_ZAPI_INSTANCE_ID=
OWNER_ZAPI_TOKEN=
OWNER_WHATSAPP_NUMBER=5545999999999
