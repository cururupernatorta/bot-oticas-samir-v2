# ─── Núcleo do bot (já existente) ───────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=400
ADMIN_PASSWORD=troque-esta-senha
PORT=3000

# ─── Agente de aquisição ────────────────────────────────────────────

# manual = agente pesquisa, qualifica e escreve; VOCÊ aprova o envio
# auto   = agente envia sozinho (só ligue após ~50 aprovações manuais)
AGENTE_MODO=manual

# O agente só roda o cron se isto for exatamente "true"
AGENTE_ATIVO=false

# Onde prospectar (nomes como aparecem no OpenStreetMap)
AGENTE_CIDADES=Belém,Ananindeua,Marituba

# Limites de segurança — anti-ban do WhatsApp e anti-multa da LGPD
AGENTE_MAX_PROSPECCAO=40
AGENTE_MAX_QUALIFICACAO=15
AGENTE_MAX_ENVIOS_DIA=20
AGENTE_MAX_ENVIOS_HORA=5
AGENTE_INTERVALO_MS=90000
AGENTE_SCORE_MINIMO=65

# Identidade comercial usada nas mensagens
AGENTE_VENDEDOR_NOME=Samir
AGENTE_EMPRESA=Atendimento 24h
AGENTE_WHATSAPP_RESPOSTA=5591999999999
AGENTE_SITE=

# Instância Z-API DEDICADA à prospecção.
# NUNCA use o mesmo número que atende clientes pagantes: se este for
# banido por denúncia de spam, você perde só a prospecção, não a operação.
AGENTE_ZAPI_INSTANCE=
AGENTE_ZAPI_TOKEN=
